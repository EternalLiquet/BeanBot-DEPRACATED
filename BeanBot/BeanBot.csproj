<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <BeanBotReleaseVersion Condition="'$(BeanBotReleaseVersion)' == ''">0.0.0-local</BeanBotReleaseVersion>
    <BeanBotCommitSha Condition="'$(BeanBotCommitSha)' == ''">unknown</BeanBotCommitSha>
    <Version>$(BeanBotReleaseVersion)</Version>
    <InformationalVersion>$(BeanBotReleaseVersion)+$(BeanBotCommitSha)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BeanBotReleaseVersion" Value="$(BeanBotReleaseVersion)" />
    <AssemblyMetadata Include="BeanBotCommitSha" Value="$(BeanBotCommitSha)" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\gordon1.gif" />
    <None Remove="Resources\gordon2.gif" />
    <None Remove="Resources\gordon3.gif" />
    <None Remove="Resources\gordon4.gif" />
    <None Remove="Resources\gordon5.gif" />
    <None Remove="Resources\gordon6.gif" />
    <None Remove="Resources\gordon7.gif" />
    <None Remove="Resources\gordon8.gif" />
    <None Remove="Resources\PR.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="Discord.Net.Commands" />
    <PackageReference Include="Discord.Net.Core" />
    <PackageReference Include="Discord.Net.Rest" />
    <PackageReference Include="Discord.Net.WebSocket" />
    <PackageReference Include="LQ.MemeApiDotNetWrapper" />
    <PackageReference Include="MongoDB.Bson" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Async" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\gordon1.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\gordon2.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\gordon3.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\gordon4.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\gordon5.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\puns.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Resources\gordon6.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\gordon7.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\gordon8.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\PR.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
